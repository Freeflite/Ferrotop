import { Theme } from "theme.slint";

export struct ProcessRow {
    icon: image,
    name: string,
    // The other columns' text, in the order the columns are shown.
    cells: [string],
    suspended: bool,
    depth: int,
    has-children: bool,
    expanded: bool,
    selected: bool,
    // 0 normal, 1 new, 2 exited, 3 own, 4 hosts services, 5 system, 6 own + elevated
    highlight: int,
}

// A column of the process list besides Name, in display order. `x` is its left edge measured
// from the end of the Name column; `kind` picks its text color (0 plain, 1 muted, 2 CPU, 3 GPU,
// 4 disk, 5 network, 6 memory); `sort` is its number for sorting.
export struct ProcessColumn {
    title: string,
    x: length,
    width: length,
    numeric: bool,
    kind: int,
    sort: int,
}

// A column the View menu can show or hide.
export struct ColumnChoice {
    title: string,
    shown: bool,
    index: int,
}

// A small history graph. Paths are drawn in a 100x100 box and stretched to fit.
export component MiniGraph inherits Rectangle {
    in property <string> line-commands;
    in property <string> fill-commands;
    in property <color> tint;

    clip: true;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        commands: root.fill-commands;
        fill: root.tint.with-alpha(0.2);
    }

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        commands: root.line-commands;
        stroke: root.tint;
        stroke-width: 1.5px;
    }
}

export component Graph inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> line-commands;
    in property <string> fill-commands;
    in property <color> tint;

    border-radius: 6px;
    background: Theme.panel-raised;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    MiniGraph {
        width: parent.width;
        height: parent.height;
        line-commands: root.line-commands;
        fill-commands: root.fill-commands;
        tint: root.tint;
    }

    Text {
        x: 8px;
        y: 5px;
        text: root.label;
        font-size: 11px;
        color: Theme.muted;
    }

    Text {
        x: parent.width - self.width - 8px;
        y: 4px;
        text: root.value;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text;
    }
}

export component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> ascending;
    in property <bool> align-right: true;
    callback clicked;

    height: 28px;
    background: touch.has-hover ? Theme.hover : transparent;
    clip: true;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;

        if root.sorted && root.align-right: Text {
            text: root.ascending ? "▲" : "▼";
            font-size: 8px;
            color: Theme.accent;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            color: root.sorted ? Theme.text : Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: root.align-right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.sorted && !root.align-right: Text {
            text: root.ascending ? "▲" : "▼";
            font-size: 8px;
            color: Theme.accent;
            vertical-alignment: center;
        }
    }
}

// A column heading that sorts when clicked, moves when dragged sideways, and resizes from the
// grip on its right edge. Reports drags; the owner decides where the column lands.
export component ColumnHeader inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> ascending;
    in property <bool> align-right: true;
    in property <bool> movable: true;
    callback clicked;
    // The new width while the grip is dragged.
    callback resized(length);
    // Dropped after a sideways drag: how far the heading moved.
    callback dropped(length);

    property <bool> dragging;
    property <length> drag-offset;
    property <length> grip-start-x;
    property <length> grip-start-width;

    height: 28px;

    header := HeaderCell {
        x: root.drag-offset;
        width: root.width;
        height: root.height;
        text: root.text;
        sorted: root.sorted;
        ascending: root.ascending;
        align-right: root.align-right;
        background: root.dragging ? Theme.selection : move.has-hover ? Theme.hover : transparent;
    }

    move := TouchArea {
        width: root.width - 6px;
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.default;
        moved => {
            if (root.movable && self.pressed && abs(self.mouse-x - self.pressed-x) > 6px) {
                root.dragging = true;
            }
            if (root.dragging) {
                root.drag-offset = self.mouse-x - self.pressed-x;
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                if (root.dragging) {
                    root.dropped(root.drag-offset);
                } else {
                    root.clicked();
                }
                root.dragging = false;
                root.drag-offset = 0;
            }
        }
    }

    // The resize grip: a thin strip on the right edge.
    grip := TouchArea {
        x: root.width - 6px;
        width: 8px;
        mouse-cursor: MouseCursor.col-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.grip-start-x = self.absolute-position.x + self.mouse-x;
                root.grip-start-width = root.width;
            }
        }
        moved => {
            if (self.pressed) {
                root.resized(max(36px, root.grip-start-width + (self.absolute-position.x + self.mouse-x - root.grip-start-x)));
            }
        }

        Rectangle {
            x: 3px;
            y: 6px;
            width: 1px;
            height: parent.height - 12px;
            background: grip.has-hover || grip.pressed ? Theme.accent : Theme.border;
        }
    }
}

component Cell inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.text;
    in property <bool> align-right: true;

    clip: true;

    Text {
        x: 6px;
        width: max(0px, parent.width - 12px);
        height: parent.height;
        text: root.text;
        color: root.text-color;
        vertical-alignment: center;
        horizontal-alignment: root.align-right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        overflow: elide;
    }
}

// Process actions offered by the right-click menu.
export enum ProcessAction { properties, open-location, end, end-tree, suspend, resume, affinity, dump, priority }

export component ProcessRowView inherits Rectangle {
    in property <ProcessRow> item;
    in property <[ProcessColumn]> columns;
    in property <length> name-width;
    in property <length> row-width;
    callback clicked;
    callback toggle;
    callback activated;
    // Right-click, with the pointer's position in window coordinates.
    callback menu-requested(length, length);

    width: root.row-width;
    height: Theme.row-height;
    background: root.item.selected ? Theme.selection
        : root.item.highlight != 0 ? Theme.highlight-color(root.item.highlight)
        : touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.activated();
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    // Accent bar so the selection stands out from the blue "system" highlight.
    if root.item.selected: Rectangle {
        x: 0;
        width: 3px;
        height: parent.height;
        background: Theme.accent-cool;
    }

    Rectangle {
        x: 0;
        width: root.name-width;
        height: parent.height;
        clip: true;

        HorizontalLayout {
            padding-left: 4px + root.item.depth * 14px;
            spacing: 2px;

            Rectangle {
                width: 16px;

                if root.item.has-children: Text {
                    text: root.item.expanded ? "▾" : "▸";
                    color: Theme.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                TouchArea {
                    enabled: root.item.has-children;
                    clicked => {
                        root.toggle();
                    }
                }
            }

            Image {
                source: root.item.icon;
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                image-rendering: smooth;
            }

            Rectangle {
                width: 3px;
            }

            Text {
                text: root.item.suspended ? root.item.name + "  (suspended)" : root.item.name;
                color: root.item.highlight == 2 || root.item.suspended ? Theme.muted : Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    for column[i] in root.columns: Cell {
        x: root.name-width + column.x;
        width: column.width;
        height: parent.height;
        text: root.item.cells[i];
        align-right: column.numeric;
        text-color: column.kind == 1 ? Theme.muted
            : column.kind == 2 ? Theme.cpu-color
            : column.kind == 3 ? Theme.gpu-color
            : column.kind == 4 ? Theme.disk-color
            : column.kind == 5 ? Theme.network-color
            : column.kind == 6 ? Theme.memory-color
            : Theme.text;
    }
}

// One entry in a popup menu.
export component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <bool> indent;
    callback activated;

    height: 26px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.selection : transparent;

    touch := TouchArea {
        clicked => {
            root.activated();
        }
    }

    Text {
        x: root.indent ? 24px : 10px;
        width: parent.width - self.x - 8px;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component MenuDivider inherits Rectangle {
    height: 9px;

    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.border;
    }
}

export component LegendItem inherits HorizontalLayout {
    in property <string> text;
    in property <brush> swatch;

    spacing: 4px;
    alignment: start;

    Rectangle {
        width: 10px;
        height: 10px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: root.swatch;
        border-width: 1px;
        border-color: Theme.border;
    }

    Text {
        text: root.text;
        font-size: 11px;
        color: Theme.muted;
        vertical-alignment: center;
    }
}

export component DetailLabel inherits Text {
    font-size: 11px;
    color: Theme.muted;
    vertical-alignment: center;
    width: 92px;
}

export component DetailValue inherits TextInput {
    read-only: true;
    single-line: true;
    color: Theme.text;
    selection-background-color: Theme.selection;
    vertical-alignment: center;
}

// A text tab in the toolbar, underlined when active.
export component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    width: label.preferred-width + 20px;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    label := Text {
        text: root.text;
        font-size: 13px;
        font-weight: root.active ? 700 : 400;
        color: root.active ? Theme.text : touch.has-hover ? Theme.text : Theme.muted;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    Rectangle {
        y: parent.height - 3px;
        x: 8px;
        width: parent.width - 16px;
        height: 3px;
        border-radius: 1.5px;
        background: root.active ? Theme.accent : transparent;
    }
}
