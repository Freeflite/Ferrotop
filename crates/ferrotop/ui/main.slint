import { AboutSlint, Button, CheckBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    ColumnChoice, ColumnHeader, DetailLabel, DetailValue, Graph, LegendItem, MenuDivider, MenuEntry, ProcessAction, ProcessColumn, ProcessRow,
    ProcessRowView, Tab,
} from "widgets.slint";
import { CellGroup, DeviceTile, GraphData, GraphPair, GraphToggle, PerformancePage, Stat } from "performance.slint";
import { DataTable, TableColumn, TablePanel, TableRowData } from "table.slint";
import { HeaderTile, HistoryGraph, HistoryGraphView, PickerRow, SeriesMenuEntry } from "history.slint";

export { Theme, ProcessRow, ProcessAction, CellGroup, DeviceTile, GraphData, GraphPair, GraphToggle, Stat, TableColumn, TableRowData }

// The generic tables, and what happened to one of them.
export enum TableId { services, network, find, properties, stack, tools, history, windows }
export enum TableEvent { sort, click, activate, move, action }

// Everything about a table except its columns and rows (which are models set once from Rust).
export struct TableMeta {
    content-width: length,
    sort-column: int,
    sort-ascending: bool,
    selected-index: int,
    status: string,
    empty-text: string,
}

export struct AffinityCpu {
    label: string,
    checked: bool,
}

// Pages: 0 Processes, 1 Performance, 2 Services, 3 Network, 4 process properties, 5 Find,
// 6 Ping and trace route, 7 History, 8 Windows.
export component MainWindow inherits Window {
    title: "Ferrotop";
    icon: @image-url("../assets/ferrotop-256.png");
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 480px;
    background: Theme.background;
    default-font-size: 12px;
    forward-focus: list-focus;

    // Theme: 0 = light, 1 = dark, 2 = follow Windows. Rust resolves "follow Windows" into `dark-mode`
    // (which drives the std widgets' palette) and sets `Theme.dark` to match.
    in property <int> theme-index;
    in property <bool> dark-mode;
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    in-out property <int> page;

    in property <[ProcessRow]> rows;
    in property <int> selected-index: -1;
    in property <int> sort-column;
    in property <bool> sort-ascending;
    in-out property <bool> tree-mode: true;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> start-at-sign-in;

    // The process list's columns besides Name, and the View menu's column checkboxes.
    in property <[ProcessColumn]> process-columns;
    in property <length> process-columns-width;
    // 0 lets the Name column fill the room left.
    in property <length> name-column-width;
    in property <[ColumnChoice]> column-choices-left;
    in property <[ColumnChoice]> column-choices-right;

    // The small graphs in the header, and the one being dragged to where (-1 when none).
    in property <[HeaderTile]> header-tiles;
    property <int> header-drag-from: -1;
    property <int> header-drag-to: -1;
    // How far the dragged one has moved.
    property <length> header-drag-x;
    // Toggled when Windows needs the window repainted: the invisible cover below changes, so the
    // whole window is drawn again (the renderer otherwise redraws only what changed).
    in property <bool> repaint-all;

    in property <string> status-cpu;
    in property <string> status-memory;
    in property <string> status-counts;
    in property <string> status-message;
    in property <bool> elevated;
    in property <string> version;

    in property <bool> has-selection;
    in property <string> detail-name;
    in property <string> detail-summary;
    in property <string> detail-identity;
    in property <string> detail-services;
    in property <string> detail-path;
    in property <string> detail-command-line;
    in property <string> detail-usage;

    in property <[DeviceTile]> devices;
    in property <int> selected-device;
    in property <string> device-title;
    in property <string> device-model;
    in property <[GraphData]> big-graphs;
    in property <[GraphPair]> graph-pairs;
    in property <[GraphData]> small-graphs;
    in property <[Stat]> stats-top;
    in property <[Stat]> stats-bottom;
    in property <[Stat]> stats-sensors;
    in property <[Stat]> device-info;
    in property <bool> show-cpu-graphs;
    in property <int> cpu-graph;
    in property <[GraphData]> cpu-cells;
    in property <[CellGroup]> cpu-cell-groups;
    in property <int> cell-columns;
    in property <string> cells-title;
    in property <bool> figures-only;
    in property <[GraphToggle]> graph-toggles;

    // Generic tables.
    in property <[TableColumn]> services-columns;
    in property <[TableRowData]> services-rows;
    in property <TableMeta> services-meta;
    in property <[TableColumn]> network-columns;
    in property <[TableRowData]> network-rows;
    in property <TableMeta> network-meta;
    in property <[TableColumn]> find-columns;
    in property <[TableRowData]> find-rows;
    in property <TableMeta> find-meta;
    in property <[TableColumn]> properties-columns;
    in property <[TableRowData]> properties-rows;
    in property <TableMeta> properties-meta;
    in property <[TableColumn]> stack-columns;
    in property <[TableRowData]> stack-rows;
    in property <TableMeta> stack-meta;
    in property <[TableColumn]> tools-columns;
    in property <[TableRowData]> tools-rows;
    in property <TableMeta> tools-meta;

    // Process properties page.
    in property <image> properties-icon;
    in property <string> properties-title;
    in property <string> properties-subtitle;
    in property <[string]> properties-tabs;
    in property <int> properties-tab;
    in property <[string]> properties-actions;

    // Find handles, DLLs or windows page.
    in property <bool> find-running;
    // Waiting for a click on some window (Pick a window).
    in property <bool> picking;

    // Ping and trace route page.
    in property <bool> tools-running;

    // Windows page.
    in property <[TableColumn]> windows-columns;
    in property <[TableRowData]> windows-rows;
    in property <TableMeta> windows-meta;
    in-out property <bool> windows-hidden;

    // History page.
    in property <[TableColumn]> history-columns;
    in property <[TableRowData]> history-rows;
    in property <TableMeta> history-meta;
    in property <[HistoryGraph]> history-graphs;
    // 0 the last hour, 1 the last 24 hours, 2 the last 7 days.
    in property <int> history-range;
    in property <string> history-axis-start;
    in property <string> history-status;
    in property <bool> history-installed;
    // Installing or removing the service.
    in property <bool> history-busy;
    // The installed service is another version of Ferrotop.
    in property <bool> history-outdated;
    // How tall the graphs are all together, whether the programs table shows, and its width.
    in property <length> history-content-height;
    in property <bool> history-programs-shown: true;
    in-out property <length> history-programs-width: 460px;
    // The Layouts menu's layouts: built-in ones, then files from the layouts folder.
    in property <[string]> history-layouts;

    // The graph picker (for History or the header) and the right-click menu that puts a
    // Performance figure in either.
    in property <string> picker-title;
    in property <string> picker-hint;
    in property <[PickerRow]> picker-rows;
    in property <[SeriesMenuEntry]> series-menu-entries;
    in-out property <string> tools-target;

    // Dialogs.
    in-out property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-button: "OK";
    in-out property <bool> run-open;
    in-out property <bool> affinity-open;
    in property <string> affinity-title;
    in property <[AffinityCpu]> affinity-cpus;
    in-out property <bool> stack-open;
    in property <string> stack-title;

    // The right-click menu: where it opens, and the process it acts on (fixed when it opened).
    property <length> menu-x;
    property <length> menu-y;
    in property <string> menu-title;
    in property <bool> menu-suspended;

    callback row-clicked(int);
    callback row-activated(int);
    callback toggle-expand(int);
    callback set-expanded(bool);
    callback move-selection(int);
    callback sort-by(int);
    callback filter-changed(string);
    callback tree-toggled(bool);
    callback theme-chosen(int);
    // A process list column was shown or hidden (by its index in the View menu's list), resized
    // (-1 for Name) or dropped with its middle at `x`.
    callback column-toggled(int, bool);
    callback process-column-resized(int, length);
    callback process-column-dropped(int, length);
    callback request-terminate();
    callback confirm-accepted();
    callback restart-elevated();
    callback select-device(int);
    callback cpu-graph-chosen(int);
    callback page-shown(int);
    callback graph-toggled(int, bool);
    // A row was right-clicked: Rust fixes which process the menu acts on.
    callback process-menu-requested(int);
    // `value` is the priority class index (0 Idle .. 5 Realtime) for `priority`, else -1.
    callback process-menu(ProcessAction, int);
    callback table-event(TableId, TableEvent, int);
    callback table-filter(TableId, string);
    // A table's column (by display position) was resized, or dropped with its middle at `x`.
    callback table-column-resized(TableId, int, length);
    callback table-column-dropped(TableId, int, length);
    callback properties-tab-chosen(int);
    callback properties-back();
    callback find-start(string);
    callback find-cancel();
    // Waits for a click on any window, then shows its process.
    callback pick-window();
    callback close-to-tray-toggled(bool);
    callback start-at-sign-in-toggled(bool);
    // Runs a network tool (0 ping, 1 trace route) against an address or host name.
    callback tools-start(int, string);
    callback tools-cancel();
    callback history-range-chosen(int);
    // A graph was dragged and dropped with its middle at `column` (in twelfths) and `y`; resized
    // (to `span` twelfths and a height); or removed.
    callback history-graph-dropped(int, float, length);
    callback history-graph-resized(int, int, length);
    callback history-graph-removed(int);
    callback history-programs-toggled();
    callback history-programs-resized(length);
    // Fill `history-layouts` before the menu opens; a layout was chosen (-1 save this one to a
    // file, -2 open the layouts folder).
    callback history-layouts-requested();
    callback history-layout-chosen(int);
    // Fill the picker for History (0) or the header (1); a figure was ticked or unticked.
    callback picker-requested(int);
    callback picker-toggled(string, bool);
    // Fill `series-menu-entries` for these graph keys; an entry was chosen.
    callback series-menu-requested(string);
    callback series-menu-chosen(string, int);
    // A header graph was dragged from one place to another.
    callback header-graph-moved(int, int);
    callback windows-hidden-toggled(bool);
    // Installs the history service, or removes it if it's installed.
    callback history-service-clicked();
    callback run-task(string, bool);
    callback affinity-toggled(int, bool);
    callback affinity-all(bool);
    callback affinity-apply();

    // Something on the Performance page was right-clicked.
    function open-series-menu(keys: string, x: length, y: length) {
        root.series-menu-requested(keys);
        if (root.series-menu-entries.length > 0) {
            root.menu-x = x;
            root.menu-y = y;
            series-menu.show();
        }
    }

    function open-picker(target: int, x: length, y: length) {
        root.picker-requested(target);
        root.menu-x = x;
        root.menu-y = y;
        picker.show();
    }

    public function show-page(page: int) {
        root.page = page;
        // Give the page the keyboard: a hidden element can't keep focus.
        if (page == 0) {
            list-focus.focus();
        } else if (page == 1) {
            performance.focus-list();
        } else if (page == 2) {
            services.focus-table();
        } else if (page == 3) {
            network.focus-table();
        } else if (page == 4) {
            properties.focus-table();
        } else if (page == 5) {
            find.focus-table();
        } else if (page == 6) {
            tools-address.focus();
        } else if (page == 7) {
            history.focus-table();
        } else if (page == 8) {
            windows.focus-table();
        }
        root.page-shown(page);
    }

    public function focus-table(table: TableId) {
        if (table == TableId.services) {
            services.focus-table();
        } else if (table == TableId.network) {
            network.focus-table();
        } else if (table == TableId.find) {
            find.focus-table();
        } else if (table == TableId.properties) {
            properties.focus-table();
        } else if (table == TableId.tools) {
            tools.focus-table();
        } else if (table == TableId.history) {
            history.focus-table();
        } else if (table == TableId.windows) {
            windows.focus-table();
        }
    }

    property <length> name-width: root.name-column-width > 0 ? root.name-column-width : max(180px, list.visible-width - root.process-columns-width);
    property <length> process-row-width: max(list.visible-width, root.name-width + root.process-columns-width);

    // Scrolls the selected process to the middle of the list, after jumping to it.
    public function reveal-selected() {
        if (root.selected-index < 0) {
            return;
        }
        list.content-y = max(min(0px, list.visible-height - root.rows.length * Theme.row-height), min(0px, -(root.selected-index * Theme.row-height - (list.visible-height - Theme.row-height) / 2)));
    }

    public function ensure-visible() {
        if (root.selected-index < 0) {
            return;
        }
        if (root.selected-index * Theme.row-height < -list.content-y) {
            list.content-y = -(root.selected-index * Theme.row-height);
        } else if ((root.selected-index + 1) * Theme.row-height > -list.content-y + list.visible-height) {
            list.content-y = -((root.selected-index + 1) * Theme.row-height - list.visible-height);
        }
    }

    // Keys no focused element handled: page switching and the properties page's tabs.
    page-keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "1") {
                root.show-page(0);
                return accept;
            }
            if (event.modifiers.control && event.text == "2") {
                root.show-page(1);
                return accept;
            }
            if (event.modifiers.control && event.text == "3") {
                root.show-page(2);
                return accept;
            }
            if (event.modifiers.control && event.text == "4") {
                root.show-page(3);
                return accept;
            }
            if (event.modifiers.control && event.text == "5") {
                root.show-page(7);
                return accept;
            }
            if (event.modifiers.control && event.text == "6") {
                root.show-page(8);
                return accept;
            }
            if (root.page == 4 && event.modifiers.control && event.text == Key.Tab) {
                root.properties-tab-chosen(mod(root.properties-tab + 1, root.properties-tabs.length));
                return accept;
            }
            if (root.page == 4 && event.modifiers.control && event.text == Key.Backtab) {
                root.properties-tab-chosen(mod(root.properties-tab + root.properties-tabs.length - 1, root.properties-tabs.length));
                return accept;
            }
            if ((root.page == 4 || root.page == 5 || root.page == 6) && event.text == Key.Escape) {
                if (root.page == 4) {
                    root.properties-back();
                } else if (root.page == 6) {
                    root.show-page(3);
                } else {
                    root.show-page(0);
                }
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Top bar: identity, page tabs, live graphs, filter and actions.
            Rectangle {
                background: Theme.panel;
                height: 66px;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: "Ferrotop";
                            font-size: 19px;
                            font-weight: 700;
                            color: Theme.accent;
                        }

                        Text {
                            text: "process explorer";
                            font-size: 10px;
                            color: Theme.muted;
                        }
                    }

                    Rectangle {
                        width: 4px;
                    }

                    Tab {
                        text: "Processes";
                        active: root.page == 0 || root.page == 4 || root.page == 5;
                        clicked => {
                            root.show-page(0);
                        }
                    }

                    Tab {
                        text: "Performance";
                        active: root.page == 1;
                        clicked => {
                            root.show-page(1);
                        }
                    }

                    Tab {
                        text: "Services";
                        active: root.page == 2;
                        clicked => {
                            root.show-page(2);
                        }
                    }

                    Tab {
                        text: "Network";
                        active: root.page == 3 || root.page == 6;
                        clicked => {
                            root.show-page(3);
                        }
                    }

                    Tab {
                        text: "History";
                        active: root.page == 7;
                        clicked => {
                            root.show-page(7);
                        }
                    }

                    Tab {
                        text: "Windows";
                        active: root.page == 8;
                        clicked => {
                            root.show-page(8);
                        }
                    }

                    Rectangle {
                        width: 4px;
                    }

                    // Drag one sideways to move it: it follows the pointer and the others slide aside
                    // to make room. Right-click to choose them.
                    for tile[index] in root.header-tiles: slot := Rectangle {
                        // One place along the row: a graph's width and the row's spacing.
                        property <length> step: self.width + 10px;

                        min-width: 84px;
                        preferred-width: 120px;
                        max-width: 120px;
                        // The dragged graph passes over the others.
                        z: root.header-drag-from == index ? 1 : 0;

                        Graph {
                            x: root.header-drag-from == index ? root.header-drag-x
                                : root.header-drag-from < 0 ? 0px
                                : root.header-drag-from < index && index <= root.header-drag-to ? -parent.step
                                : root.header-drag-to <= index && index < root.header-drag-from ? parent.step
                                : 0px;
                            width: parent.width;
                            height: parent.height;
                            label: tile.label;
                            value: tile.value;
                            line-commands: tile.line;
                            fill-commands: tile.fill;
                            tint: Theme.device-color(tile.kind);
                            border-color: root.header-drag-from == index ? Theme.device-color(tile.kind) : Theme.border;
                            drop-shadow-blur: root.header-drag-from == index ? 10px : 0px;
                            drop-shadow-color: #00000070;
                            // The others slide; the dragged one stays under the pointer, and
                            // everything lands at once when it's dropped.
                            animate x {
                                duration: root.header-drag-from >= 0 && root.header-drag-from != index ? 150ms : 0ms;
                                easing: ease-out;
                            }

                            TouchArea {
                                property <length> start-x;

                                mouse-cursor: root.header-drag-from == index ? MouseCursor.grabbing : MouseCursor.grab;
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                        self.start-x = self.absolute-position.x + self.mouse-x;
                                    }
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                        if (root.header-drag-from == index && root.header-drag-to != index) {
                                            root.header-graph-moved(index, root.header-drag-to);
                                        }
                                        root.header-drag-from = -1;
                                        root.header-drag-to = -1;
                                        root.header-drag-x = 0;
                                    }
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                        root.open-picker(1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                                moved => {
                                    // From where the pointer went down, whichever way the graph has moved since.
                                    if (self.pressed && (root.header-drag-from == index || abs(self.absolute-position.x + self.mouse-x - self.start-x) > 6px)) {
                                        root.header-drag-x = self.absolute-position.x + self.mouse-x - self.start-x;
                                        root.header-drag-from = index;
                                        root.header-drag-to = max(0, min(root.header-tiles.length - 1, index + round(root.header-drag-x / slot.step)));
                                    }
                                }
                            }
                        }
                    }

                    if root.header-tiles.length == 0: Rectangle {
                        width: 60px;

                        TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                    root.open-picker(1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if root.page == 0: VerticalLayout {
                        alignment: center;

                        LineEdit {
                            width: 190px;
                            placeholder-text: "Filter: name, description, PID";
                            edited(text) => {
                                root.filter-changed(text);
                            }
                            accepted => {
                                list-focus.focus();
                            }
                        }
                    }

                    if root.page == 0: VerticalLayout {
                        alignment: center;

                        Button {
                            text: "End process";
                            enabled: root.has-selection;
                            clicked => {
                                root.request-terminate();
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Button {
                            text: "View";
                            clicked => {
                                view-menu.show();
                            }
                        }
                    }
                }
            }

            // The pages share this space; hidden ones keep their state.
            Rectangle {
                vertical-stretch: 1;

                Rectangle {
                    visible: root.page == 0;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        // Column headers. Absolutely positioned (not a layout) so the column widths,
                        // which follow the list's width, don't feed back into the window's minimum size.
                        Rectangle {
                            background: Theme.panel;
                            height: 28px;
                            clip: true;

                            Rectangle {
                                x: list.content-x;
                                width: root.process-row-width;
                                height: parent.height;

                                ColumnHeader {
                                    x: 0;
                                    width: root.name-width;
                                    text: "Name";
                                    align-right: false;
                                    movable: false;
                                    sorted: root.sort-column == 1;
                                    ascending: root.sort-ascending;
                                    clicked => {
                                        root.sort-by(1);
                                    }
                                    resized(width) => {
                                        root.process-column-resized(-1, width);
                                    }
                                }

                                for column[i] in root.process-columns: ColumnHeader {
                                    x: root.name-width + column.x;
                                    width: column.width;
                                    text: column.title;
                                    align-right: column.numeric;
                                    sorted: root.sort-column == column.sort;
                                    ascending: root.sort-ascending;
                                    clicked => {
                                        root.sort-by(column.sort);
                                    }
                                    resized(width) => {
                                        root.process-column-resized(i, width);
                                    }
                                    dropped(offset) => {
                                        root.process-column-dropped(i, column.x + offset + column.width / 2);
                                    }
                                }
                            }

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.border;
                            }
                        }

                        // The process list.
                        list-focus := FocusScope {
                            vertical-stretch: 1;

                            key-pressed(event) => {
                                if (event.modifiers.control && event.text == "2") {
                                    root.show-page(1);
                                    return accept;
                                }
                                if (event.modifiers.control && event.text == "3") {
                                    root.show-page(2);
                                    return accept;
                                }
                                if (event.modifiers.control && event.text == "4") {
                                    root.show-page(3);
                                    return accept;
                                }
                                if (event.modifiers.control && event.text == "5") {
                                    root.show-page(7);
                                    return accept;
                                }
                                if (event.modifiers.control && event.text == "6") {
                                    root.show-page(8);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.move-selection(-1);
                                    root.ensure-visible();
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move-selection(1);
                                    root.ensure-visible();
                                    return accept;
                                }
                                if (event.text == Key.PageUp) {
                                    root.move-selection(-20);
                                    root.ensure-visible();
                                    return accept;
                                }
                                if (event.text == Key.PageDown) {
                                    root.move-selection(20);
                                    root.ensure-visible();
                                    return accept;
                                }
                                if (event.text == Key.LeftArrow) {
                                    root.set-expanded(false);
                                    return accept;
                                }
                                if (event.text == Key.RightArrow) {
                                    root.set-expanded(true);
                                    return accept;
                                }
                                if (event.text == Key.Delete) {
                                    root.request-terminate();
                                    return accept;
                                }
                                if (event.text == Key.Return && root.selected-index >= 0) {
                                    root.row-activated(root.selected-index);
                                    return accept;
                                }
                                reject
                            }

                            list := ListView {
                                width: parent.width;
                                height: parent.height;
                                // Wider than the window when the columns are: scroll sideways.
                                content-width: root.process-row-width;

                                for row[index] in root.rows: ProcessRowView {
                                    item: row;
                                    columns: root.process-columns;
                                    name-width: root.name-width;
                                    row-width: root.process-row-width;
                                    clicked => {
                                        list-focus.focus();
                                        root.row-clicked(index);
                                    }
                                    toggle => {
                                        list-focus.focus();
                                        root.toggle-expand(index);
                                    }
                                    activated => {
                                        root.row-activated(index);
                                    }
                                    menu-requested(x, y) => {
                                        list-focus.focus();
                                        root.menu-x = x;
                                        root.menu-y = y;
                                        root.process-menu-requested(index);
                                        process-menu.show();
                                    }
                                }
                            }
                        }

                        // Details for the selected process.
                        if root.has-selection: Rectangle {
                            background: Theme.panel;

                            Rectangle {
                                height: 1px;
                                y: 0;
                                background: Theme.border;
                            }

                            VerticalLayout {
                                padding: 10px;
                                padding-left: 14px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 10px;

                                    Text {
                                        text: root.detail-name;
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: root.detail-summary;
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        text: "Properties";
                                        clicked => {
                                            root.row-activated(root.selected-index);
                                        }
                                    }
                                }

                                if root.detail-identity != "": Text {
                                    text: root.detail-identity;
                                    color: Theme.text;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    DetailLabel {
                                        text: "Image path";
                                    }

                                    DetailValue {
                                        text: root.detail-path;
                                    }
                                }

                                HorizontalLayout {
                                    DetailLabel {
                                        text: "Command line";
                                    }

                                    DetailValue {
                                        text: root.detail-command-line;
                                    }
                                }

                                if root.detail-services != "": HorizontalLayout {
                                    DetailLabel {
                                        text: "Services";
                                    }

                                    DetailValue {
                                        text: root.detail-services;
                                    }
                                }

                                HorizontalLayout {
                                    DetailLabel {
                                        text: "Usage";
                                    }

                                    Text {
                                        text: root.detail-usage;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                performance := PerformancePage {
                    visible: root.page == 1;
                    width: parent.width;
                    height: parent.height;
                    devices: root.devices;
                    selected-device: root.selected-device;
                    title: root.device-title;
                    model: root.device-model;
                    big-graphs: root.big-graphs;
                    graph-pairs: root.graph-pairs;
                    small-graphs: root.small-graphs;
                    stats-top: root.stats-top;
                    stats-bottom: root.stats-bottom;
                    stats-sensors: root.stats-sensors;
                    info: root.device-info;
                    show-cpu-graphs: root.show-cpu-graphs;
                    cpu-graph: root.cpu-graph;
                    cells: root.cpu-cells;
                    cell-groups: root.cpu-cell-groups;
                    cell-columns: root.cell-columns;
                    cells-title: root.cells-title;
                    figures-only: root.figures-only;
                    select-device(index) => {
                        root.select-device(index);
                    }
                    cpu-graph-chosen(graph) => {
                        root.cpu-graph-chosen(graph);
                    }
                    show-page(page) => {
                        root.show-page(page);
                    }
                    series-menu(keys, x, y) => {
                        root.open-series-menu(keys, x, y);
                    }
                }

                services := TablePanel {
                    visible: root.page == 2;
                    width: parent.width;
                    height: parent.height;
                    padding-top: 10px;
                    columns: root.services-columns;
                    rows: root.services-rows;
                    content-width: root.services-meta.content-width;
                    sort-column: root.services-meta.sort-column;
                    sort-ascending: root.services-meta.sort-ascending;
                    selected-index: root.services-meta.selected-index;
                    status: root.services-meta.status;
                    empty-text: root.services-meta.empty-text;
                    filter-placeholder: "Filter services";
                    actions: ["Start", "Stop", "Restart", "Go to process"];
                    filter-changed(text) => {
                        root.table-filter(TableId.services, text);
                    }
                    column-resized(index, width) => {
                        root.table-column-resized(TableId.services, index, width);
                    }
                    column-dropped(index, x) => {
                        root.table-column-dropped(TableId.services, index, x);
                    }
                    sort-by(column) => {
                        root.table-event(TableId.services, TableEvent.sort, column);
                    }
                    row-clicked(index) => {
                        root.table-event(TableId.services, TableEvent.click, index);
                    }
                    row-activated(index) => {
                        root.table-event(TableId.services, TableEvent.activate, index);
                    }
                    move-selection(step) => {
                        root.table-event(TableId.services, TableEvent.move, step);
                    }
                    action(index) => {
                        root.table-event(TableId.services, TableEvent.action, index);
                    }
                }

                network := TablePanel {
                    visible: root.page == 3;
                    width: parent.width;
                    height: parent.height;
                    padding-top: 10px;
                    columns: root.network-columns;
                    rows: root.network-rows;
                    content-width: root.network-meta.content-width;
                    sort-column: root.network-meta.sort-column;
                    sort-ascending: root.network-meta.sort-ascending;
                    selected-index: root.network-meta.selected-index;
                    status: root.network-meta.status;
                    empty-text: root.network-meta.empty-text;
                    filter-placeholder: "Filter connections";
                    actions: ["Go to process", "Ping", "Trace route"];
                    filter-changed(text) => {
                        root.table-filter(TableId.network, text);
                    }
                    column-resized(index, width) => {
                        root.table-column-resized(TableId.network, index, width);
                    }
                    column-dropped(index, x) => {
                        root.table-column-dropped(TableId.network, index, x);
                    }
                    sort-by(column) => {
                        root.table-event(TableId.network, TableEvent.sort, column);
                    }
                    row-clicked(index) => {
                        root.table-event(TableId.network, TableEvent.click, index);
                    }
                    row-activated(index) => {
                        root.table-event(TableId.network, TableEvent.activate, index);
                    }
                    move-selection(step) => {
                        root.table-event(TableId.network, TableEvent.move, step);
                    }
                    action(index) => {
                        root.table-event(TableId.network, TableEvent.action, index);
                    }
                }

                // Process properties.
                Rectangle {
                    visible: root.page == 4;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        spacing: 6px;

                        Rectangle {
                            background: Theme.panel;
                            height: 58px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: "‹ Back";
                                        clicked => {
                                            root.properties-back();
                                        }
                                    }
                                }

                                Image {
                                    source: root.properties-icon;
                                    width: 32px;
                                    height: 32px;
                                    y: (parent.height - self.height) / 2;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: root.properties-title;
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: Theme.text;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.properties-subtitle;
                                        color: Theme.muted;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            height: 34px;

                            for tab[i] in root.properties-tabs: Tab {
                                text: tab;
                                active: i == root.properties-tab;
                                clicked => {
                                    root.properties-tab-chosen(i);
                                }
                            }

                            Rectangle { }
                        }

                        properties := TablePanel {
                            vertical-stretch: 1;
                            columns: root.properties-columns;
                            rows: root.properties-rows;
                            content-width: root.properties-meta.content-width;
                            sort-column: root.properties-meta.sort-column;
                            sort-ascending: root.properties-meta.sort-ascending;
                            selected-index: root.properties-meta.selected-index;
                            status: root.properties-meta.status;
                            empty-text: root.properties-meta.empty-text;
                            actions: root.properties-actions;
                            filter-changed(text) => {
                                root.table-filter(TableId.properties, text);
                            }
                            column-resized(index, width) => {
                                root.table-column-resized(TableId.properties, index, width);
                            }
                            column-dropped(index, x) => {
                                root.table-column-dropped(TableId.properties, index, x);
                            }
                            sort-by(column) => {
                                root.table-event(TableId.properties, TableEvent.sort, column);
                            }
                            row-clicked(index) => {
                                root.table-event(TableId.properties, TableEvent.click, index);
                            }
                            row-activated(index) => {
                                root.table-event(TableId.properties, TableEvent.activate, index);
                            }
                            move-selection(step) => {
                                root.table-event(TableId.properties, TableEvent.move, step);
                            }
                            action(index) => {
                                root.table-event(TableId.properties, TableEvent.action, index);
                            }
                        }
                    }
                }

                // Find handles or DLLs.
                Rectangle {
                    visible: root.page == 5;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        spacing: 8px;

                        Rectangle {
                            background: Theme.panel;
                            height: 50px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: "‹ Back";
                                        clicked => {
                                            root.show-page(0);
                                        }
                                    }
                                }

                                Text {
                                    text: "Find handles, DLLs or windows";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;

                                    query := LineEdit {
                                        width: 320px;
                                        placeholder-text: "Part of a window title, file, key, mutex or DLL name";
                                        accepted(text) => {
                                            root.find-start(text);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: root.find-running ? "Cancel" : "Search";
                                        primary: !root.find-running;
                                        clicked => {
                                            if (root.find-running) {
                                                root.find-cancel();
                                            } else {
                                                root.find-start(query.text);
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: root.picking ? "Click a window… (right-click cancels)" : "Pick a window";
                                        primary: root.picking;
                                        clicked => {
                                            root.pick-window();
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        find := TablePanel {
                            vertical-stretch: 1;
                            columns: root.find-columns;
                            rows: root.find-rows;
                            content-width: root.find-meta.content-width;
                            sort-column: root.find-meta.sort-column;
                            sort-ascending: root.find-meta.sort-ascending;
                            selected-index: root.find-meta.selected-index;
                            status: root.find-meta.status;
                            empty-text: root.find-meta.empty-text;
                            filter-placeholder: "Filter results";
                            actions: ["Go to process"];
                            filter-changed(text) => {
                                root.table-filter(TableId.find, text);
                            }
                            column-resized(index, width) => {
                                root.table-column-resized(TableId.find, index, width);
                            }
                            column-dropped(index, x) => {
                                root.table-column-dropped(TableId.find, index, x);
                            }
                            sort-by(column) => {
                                root.table-event(TableId.find, TableEvent.sort, column);
                            }
                            row-clicked(index) => {
                                root.table-event(TableId.find, TableEvent.click, index);
                            }
                            row-activated(index) => {
                                root.table-event(TableId.find, TableEvent.activate, index);
                            }
                            move-selection(step) => {
                                root.table-event(TableId.find, TableEvent.move, step);
                            }
                            action(index) => {
                                root.table-event(TableId.find, TableEvent.action, index);
                            }
                        }
                    }
                }

                // Windows.
                Rectangle {
                    visible: root.page == 8;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        spacing: 8px;

                        Rectangle {
                            background: Theme.panel;
                            height: 50px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                Text {
                                    text: "Windows";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;

                                    CheckBox {
                                        text: "Show all windows (hidden and untitled too)";
                                        checked <=> root.windows-hidden;
                                        toggled => {
                                            root.windows-hidden-toggled(self.checked);
                                        }
                                    }
                                }

                                Text {
                                    text: "Every window on this desktop and the process it belongs to. Find… → Pick a window jumps straight to the one you click.";
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        windows := TablePanel {
                            vertical-stretch: 1;
                            columns: root.windows-columns;
                            rows: root.windows-rows;
                            content-width: root.windows-meta.content-width;
                            sort-column: root.windows-meta.sort-column;
                            sort-ascending: root.windows-meta.sort-ascending;
                            selected-index: root.windows-meta.selected-index;
                            status: root.windows-meta.status;
                            empty-text: root.windows-meta.empty-text;
                            filter-placeholder: "Filter by process, title or class";
                            actions: ["Go to process", "Bring to front"];
                            filter-changed(text) => {
                                root.table-filter(TableId.windows, text);
                            }
                            column-resized(index, width) => {
                                root.table-column-resized(TableId.windows, index, width);
                            }
                            column-dropped(index, x) => {
                                root.table-column-dropped(TableId.windows, index, x);
                            }
                            sort-by(column) => {
                                root.table-event(TableId.windows, TableEvent.sort, column);
                            }
                            row-clicked(index) => {
                                root.table-event(TableId.windows, TableEvent.click, index);
                            }
                            row-activated(index) => {
                                root.table-event(TableId.windows, TableEvent.activate, index);
                            }
                            move-selection(step) => {
                                root.table-event(TableId.windows, TableEvent.move, step);
                            }
                            action(index) => {
                                root.table-event(TableId.windows, TableEvent.action, index);
                            }
                        }
                    }
                }

                // History.
                Rectangle {
                    visible: root.page == 7;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        spacing: 8px;

                        Rectangle {
                            background: Theme.panel;
                            height: 50px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                Text {
                                    text: "History";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 6px;
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: "Last hour";
                                        primary: root.history-range == 0;
                                        clicked => {
                                            root.history-range-chosen(0);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: "24 hours";
                                        primary: root.history-range == 1;
                                        clicked => {
                                            root.history-range-chosen(1);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: "7 days";
                                        primary: root.history-range == 2;
                                        clicked => {
                                            root.history-range-chosen(2);
                                        }
                                    }
                                }

                                Text {
                                    text: root.history-status;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: "Add graphs…";
                                        clicked => {
                                            root.open-picker(0, root.width - 420px, 104px);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: "Layouts";
                                        clicked => {
                                            root.history-layouts-requested();
                                            layouts-menu.show();
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: "Programs";
                                        primary: root.history-programs-shown;
                                        clicked => {
                                            root.history-programs-toggled();
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: root.history-busy ? "Working…" : root.history-outdated ? "Update service…" : root.history-installed ? "Stop recording…" : "Record history…";
                                        enabled: !root.history-busy;
                                        clicked => {
                                            root.history-service-clicked();
                                        }
                                    }
                                }
                            }
                        }

                        history-row := HorizontalLayout {
                            vertical-stretch: 1;
                            padding-left: 12px;
                            padding-right: 12px;

                            history-area := ScrollView {
                                horizontal-stretch: 1;
                                content-width: self.visible-width;
                                content-height: max(self.visible-height, root.history-content-height + 36px);

                                for graph[index] in root.history-graphs: HistoryGraphView {
                                    data: graph;
                                    unit: history-area.visible-width / 12;
                                    axis-start: root.history-axis-start;
                                    dropped(column, y) => {
                                        root.history-graph-dropped(index, column, y);
                                    }
                                    resized(span, height) => {
                                        root.history-graph-resized(index, span, height);
                                    }
                                    removed => {
                                        root.history-graph-removed(index);
                                    }
                                }

                                if root.history-graphs.length > 0: Text {
                                    x: 0;
                                    y: root.history-content-height + 12px;
                                    text: "Drag a graph by its title to move it, or by its right or bottom edge to resize it. × removes it.";
                                    font-size: 11px;
                                    color: Theme.muted;
                                }

                                if root.history-graphs.length == 0: Text {
                                    x: 20px;
                                    y: 30px;
                                    width: history-area.visible-width - 40px;
                                    text: "No graphs. Add some with Add graphs… or Layouts, or right-click anything on the Performance page and choose Show in History.";
                                    color: Theme.muted;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }

                            // Drag to share the room between the graphs and the programs.
                            if root.history-programs-shown: Rectangle {
                                width: 11px;

                                Rectangle {
                                    x: 5px;
                                    width: 1px;
                                    background: splitter.has-hover || splitter.pressed ? Theme.accent-cool : Theme.border;
                                }

                                splitter := TouchArea {
                                    property <length> start-width;
                                    property <length> start-x;

                                    mouse-cursor: col-resize;
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                            self.start-width = root.history-programs-width;
                                            self.start-x = self.absolute-position.x + self.mouse-x;
                                        }
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                            root.history-programs-resized(root.history-programs-width);
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            root.history-programs-width = max(240px, min(history-row.width - 340px, self.start-width - (self.absolute-position.x + self.mouse-x - self.start-x)));
                                        }
                                    }
                                }
                            }

                            history := TablePanel {
                                visible: root.history-programs-shown;
                                width: root.history-programs-shown ? root.history-programs-width : 0px;
                                columns: root.history-columns;
                                rows: root.history-rows;
                                content-width: root.history-meta.content-width;
                                sort-column: root.history-meta.sort-column;
                                sort-ascending: root.history-meta.sort-ascending;
                                selected-index: root.history-meta.selected-index;
                                status: root.history-meta.status;
                                empty-text: root.history-meta.empty-text;
                                filter-placeholder: "Filter programs";
                                actions: [];
                                filter-changed(text) => {
                                    root.table-filter(TableId.history, text);
                                }
                                column-resized(index, width) => {
                                    root.table-column-resized(TableId.history, index, width);
                                }
                                column-dropped(index, x) => {
                                    root.table-column-dropped(TableId.history, index, x);
                                }
                                sort-by(column) => {
                                    root.table-event(TableId.history, TableEvent.sort, column);
                                }
                                row-clicked(index) => {
                                    root.table-event(TableId.history, TableEvent.click, index);
                                }
                                row-activated(index) => {
                                    root.table-event(TableId.history, TableEvent.activate, index);
                                }
                                move-selection(step) => {
                                    root.table-event(TableId.history, TableEvent.move, step);
                                }
                            }
                        }
                    }
                }

                // Ping and trace route.
                Rectangle {
                    visible: root.page == 6;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        spacing: 8px;

                        Rectangle {
                            background: Theme.panel;
                            height: 50px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: "‹ Back";
                                        clicked => {
                                            root.show-page(3);
                                        }
                                    }
                                }

                                Text {
                                    text: "Ping and trace route";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;

                                    tools-address := LineEdit {
                                        width: 320px;
                                        placeholder-text: "IP address or host name";
                                        text <=> root.tools-target;
                                        accepted(text) => {
                                            root.tools-start(0, text);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: root.tools-running ? "Cancel" : "Ping";
                                        primary: !root.tools-running;
                                        clicked => {
                                            if (root.tools-running) {
                                                root.tools-cancel();
                                            } else {
                                                root.tools-start(0, tools-address.text);
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Button {
                                        text: "Trace route";
                                        enabled: !root.tools-running;
                                        clicked => {
                                            root.tools-start(1, tools-address.text);
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        tools := TablePanel {
                            vertical-stretch: 1;
                            columns: root.tools-columns;
                            rows: root.tools-rows;
                            content-width: root.tools-meta.content-width;
                            sort-column: root.tools-meta.sort-column;
                            sort-ascending: root.tools-meta.sort-ascending;
                            selected-index: root.tools-meta.selected-index;
                            status: root.tools-meta.status;
                            empty-text: root.tools-meta.empty-text;
                            filter-placeholder: "Filter results";
                            actions: [];
                            filter-changed(text) => {
                                root.table-filter(TableId.tools, text);
                            }
                            column-resized(index, width) => {
                                root.table-column-resized(TableId.tools, index, width);
                            }
                            column-dropped(index, x) => {
                                root.table-column-dropped(TableId.tools, index, x);
                            }
                            sort-by(column) => {
                                root.table-event(TableId.tools, TableEvent.sort, column);
                            }
                            row-clicked(index) => {
                                root.table-event(TableId.tools, TableEvent.click, index);
                            }
                            row-activated(index) => {
                                root.table-event(TableId.tools, TableEvent.activate, index);
                            }
                            move-selection(step) => {
                                root.table-event(TableId.tools, TableEvent.move, step);
                            }
                        }
                    }
                }
            }

            // Status bar.
            Rectangle {
                background: Theme.panel;
                height: 28px;

                Rectangle {
                    height: 1px;
                    y: 0;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 16px;

                    Text {
                        text: root.status-cpu;
                        color: Theme.text;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.status-memory;
                        color: Theme.text;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.status-counts;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.status-message;
                        color: Theme.accent;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    if root.elevated: Text {
                        text: "Administrator";
                        color: Theme.accent;
                        vertical-alignment: center;
                    }

                    if !root.elevated: Rectangle {
                        width: run-as-admin.preferred-width;

                        run-as-admin := Text {
                            text: "Run as administrator";
                            color: Theme.accent-cool;
                            vertical-alignment: center;
                            height: parent.height;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.restart-elevated();
                            }
                        }
                    }
                }
            }
        }
    }

    // Confirmation for actions that can't be undone, drawn over everything.
    if root.confirm-open: Rectangle {
        background: #000000a8;
        init => {
            dialog-keys.focus();
        }

        TouchArea { }

        // Enter confirms, Escape cancels.
        dialog-keys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.confirm-open = false;
                    list-focus.focus();
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.confirm-open = false;
                    root.confirm-accepted();
                    list-focus.focus();
                    return accept;
                }
                reject
            }
        }

        Rectangle {
            width: 460px;
            height: 210px;
            border-radius: 8px;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: root.confirm-title;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text;
                    overflow: elide;
                }

                Text {
                    text: root.confirm-text;
                    wrap: word-wrap;
                    color: Theme.muted;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => {
                            root.confirm-open = false;
                            list-focus.focus();
                        }
                    }

                    Button {
                        text: root.confirm-button;
                        primary: true;
                        clicked => {
                            root.confirm-open = false;
                            root.confirm-accepted();
                            list-focus.focus();
                        }
                    }
                }
            }
        }
    }

    // Run a new program, like the Run box.
    if root.run-open: Rectangle {
        background: #000000a8;

        TouchArea { }

        Rectangle {
            width: 480px;
            height: 200px;
            border-radius: 8px;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "Run new task";
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text;
                }

                Text {
                    text: root.elevated
                        ? "Ferrotop is running as administrator, so the program will be too."
                        : "Type the name of a program, folder or document.";
                    color: Theme.muted;
                    wrap: word-wrap;
                }

                command := LineEdit {
                    placeholder-text: "e.g. notepad, cmd, or a quoted path with arguments";
                    init => {
                        self.focus();
                    }
                    accepted(text) => {
                        root.run-open = false;
                        root.run-task(text, run-elevated.checked);
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    run-elevated := CheckBox {
                        text: "Run as administrator";
                        enabled: !root.elevated;
                        checked: root.elevated;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Cancel";
                        clicked => {
                            root.run-open = false;
                        }
                    }

                    Button {
                        text: "Run";
                        primary: true;
                        clicked => {
                            root.run-open = false;
                            root.run-task(command.text, run-elevated.checked);
                        }
                    }
                }
            }
        }
    }

    // Which logical processors a process may run on.
    if root.affinity-open: Rectangle {
        background: #000000a8;

        TouchArea { }

        Rectangle {
            width: 620px;
            height: min(root.height - 40px, 140px + ceil(root.affinity-cpus.length / 8) * 26px);
            border-radius: 8px;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: root.affinity-title;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text;
                    overflow: elide;
                }

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    for cpu[i] in root.affinity-cpus: CheckBox {
                        x: mod(i, 8) * 72px;
                        y: floor(i / 8) * 26px;
                        width: 70px;
                        text: cpu.label;
                        checked: cpu.checked;
                        toggled => {
                            root.affinity-toggled(i, self.checked);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Button {
                        text: "All";
                        clicked => {
                            root.affinity-all(true);
                        }
                    }

                    Button {
                        text: "None";
                        clicked => {
                            root.affinity-all(false);
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Cancel";
                        clicked => {
                            root.affinity-open = false;
                        }
                    }

                    Button {
                        text: "Apply";
                        primary: true;
                        clicked => {
                            root.affinity-open = false;
                            root.affinity-apply();
                        }
                    }
                }
            }
        }
    }

    // A thread's call stack.
    if root.stack-open: Rectangle {
        background: #000000a8;

        TouchArea { }

        Rectangle {
            width: min(root.width - 60px, 900px);
            height: min(root.height - 60px, 560px);
            border-radius: 8px;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: root.stack-title;
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Button {
                        text: "Close";
                        clicked => {
                            root.stack-open = false;
                        }
                    }
                }

                DataTable {
                    vertical-stretch: 1;
                    columns: root.stack-columns;
                    rows: root.stack-rows;
                    content-width: root.stack-meta.content-width;
                    selected-index: root.stack-meta.selected-index;
                    empty-text: root.stack-meta.empty-text;
                    row-clicked(index) => {
                        root.table-event(TableId.stack, TableEvent.click, index);
                    }
                    move-selection(step) => {
                        root.table-event(TableId.stack, TableEvent.move, step);
                    }
                    column-resized(index, width) => {
                        root.table-column-resized(TableId.stack, index, width);
                    }
                    column-dropped(index, x) => {
                        root.table-column-dropped(TableId.stack, index, x);
                    }
                }
            }
        }
    }

    // Invisible either way; see `repaint-all`.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: root.repaint-all ? #ffffff00 : #00000000;
    }

    process-menu := PopupWindow {
        x: max(0px, min(root.menu-x, root.width - self.width - 4px));
        y: max(0px, min(root.menu-y, root.height - self.height - 4px));
        width: 230px;
        height: 432px;

        Rectangle {
            border-radius: 8px;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 6px;

                Text {
                    height: 26px;
                    text: root.menu-title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }

                MenuDivider { }

                MenuEntry {
                    text: "Properties";
                    activated => {
                        root.process-menu(ProcessAction.properties, -1);
                    }
                }

                MenuEntry {
                    text: "Open file location";
                    activated => {
                        root.process-menu(ProcessAction.open-location, -1);
                    }
                }

                MenuDivider { }

                MenuEntry {
                    text: "End process";
                    activated => {
                        root.process-menu(ProcessAction.end, -1);
                    }
                }

                MenuEntry {
                    text: "End process tree";
                    activated => {
                        root.process-menu(ProcessAction.end-tree, -1);
                    }
                }

                MenuEntry {
                    text: root.menu-suspended ? "Resume" : "Suspend";
                    activated => {
                        root.process-menu(root.menu-suspended ? ProcessAction.resume : ProcessAction.suspend, -1);
                    }
                }

                MenuDivider { }

                Text {
                    height: 22px;
                    x: 10px;
                    text: "Priority";
                    font-size: 11px;
                    color: Theme.muted;
                    vertical-alignment: center;
                }

                for label[i] in ["Realtime", "High", "Above normal", "Normal", "Below normal", "Idle"]: MenuEntry {
                    text: label;
                    indent: true;
                    activated => {
                        root.process-menu(ProcessAction.priority, 5 - i);
                    }
                }

                MenuEntry {
                    text: "Set affinity…";
                    activated => {
                        root.process-menu(ProcessAction.affinity, -1);
                    }
                }

                MenuDivider { }

                MenuEntry {
                    text: "Create dump file";
                    activated => {
                        root.process-menu(ProcessAction.dump, -1);
                    }
                }
            }
        }
    }

    series-menu := PopupWindow {
        x: max(0px, min(root.menu-x, root.width - self.width - 4px));
        y: max(0px, min(root.menu-y, root.height - self.height - 4px));
        width: 380px;
        height: root.series-menu-entries.length * 26px + 40px;

        Rectangle {
            border-radius: 8px;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 6px;

                Text {
                    height: 26px;
                    text: "History and header";
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                for entry in root.series-menu-entries: MenuEntry {
                    text: entry.text;
                    activated => {
                        root.series-menu-chosen(entry.key, entry.target);
                    }
                }
            }
        }
    }

    picker := PopupWindow {
        x: max(0px, min(root.menu-x, root.width - self.width - 4px));
        y: max(0px, min(root.menu-y, root.height - self.height - 4px));
        width: 400px;
        height: min(root.height - 40px, 620px);
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 8px;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 10px;
                spacing: 4px;

                Text {
                    text: root.picker-title;
                    font-weight: 700;
                    color: Theme.text;
                }

                Text {
                    text: root.picker-hint;
                    font-size: 11px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }

                ListView {
                    for row in root.picker-rows: Rectangle {
                        height: 26px;

                        if row.heading: Text {
                            x: 2px;
                            height: parent.height;
                            text: row.title;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: bottom;
                        }

                        if !row.heading: CheckBox {
                            x: 12px;
                            text: row.title;
                            checked: row.shown;
                            toggled => {
                                root.picker-toggled(row.key, self.checked);
                            }
                        }
                    }
                }
            }
        }
    }

    layouts-menu := PopupWindow {
        x: root.width - self.width - 16px;
        y: 104px;
        width: 300px;
        height: (root.history-layouts.length + 2) * 26px + 52px;

        Rectangle {
            border-radius: 8px;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 6px;

                Text {
                    height: 26px;
                    text: "Layouts";
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                for layout[index] in root.history-layouts: MenuEntry {
                    text: layout;
                    activated => {
                        root.history-layout-chosen(index);
                    }
                }

                MenuDivider { }

                MenuEntry {
                    text: "Save this layout to a file";
                    activated => {
                        root.history-layout-chosen(-1);
                    }
                }

                MenuEntry {
                    text: "Open the layouts folder";
                    activated => {
                        root.history-layout-chosen(-2);
                    }
                }
            }
        }
    }

    view-menu := PopupWindow {
        x: root.width - 314px;
        y: 60px;
        width: 300px;
        height: (root.page == 0 ? 562px : root.page == 1 ? 204px + root.graph-toggles.length * 28px : 184px) + 36px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 8px;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: "Theme";
                    font-weight: 600;
                    color: Theme.text;
                }

                HorizontalLayout {
                    spacing: 6px;

                    Button {
                        text: "Light";
                        primary: root.theme-index == 0;
                        clicked => {
                            root.theme-chosen(0);
                        }
                    }

                    Button {
                        text: "Dark";
                        primary: root.theme-index == 1;
                        clicked => {
                            root.theme-chosen(1);
                        }
                    }

                    Button {
                        text: "System";
                        primary: root.theme-index == 2;
                        clicked => {
                            root.theme-chosen(2);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    CheckBox {
                        text: "Close to tray";
                        checked <=> root.close-to-tray;
                        toggled => {
                            root.close-to-tray-toggled(self.checked);
                        }
                    }

                    CheckBox {
                        text: "Start at sign-in";
                        checked <=> root.start-at-sign-in;
                        toggled => {
                            root.start-at-sign-in-toggled(self.checked);
                        }
                    }
                }

                HorizontalLayout {
                    alignment: start;

                    Button {
                        text: "Header graphs…";
                        clicked => {
                            view-menu.close();
                            root.open-picker(1, root.width - 420px, 60px);
                        }
                    }
                }

                // Performance: the selected device's graphs.
                if root.page == 1: Text {
                    text: root.graph-toggles.length > 0 ? "Graphs: " + root.device-title : "No graphs for this device";
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }

                if root.page == 1: VerticalLayout {
                    spacing: 2px;

                    for toggle[i] in root.graph-toggles: CheckBox {
                        text: toggle.title;
                        checked: toggle.shown;
                        toggled => {
                            root.graph-toggled(i, self.checked);
                        }
                    }
                }

                if root.page == 1 && root.graph-toggles.length > 0: Text {
                    text: "Hide them all to see the figures large.";
                    font-size: 11px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }

                // Processes: tree mode, columns and the highlight legend.
                if root.page == 0: CheckBox {
                    text: "Show as tree";
                    checked <=> root.tree-mode;
                    toggled => {
                        root.tree-toggled(self.checked);
                    }
                }

                if root.page == 0: Text {
                    text: "Columns";
                    font-weight: 600;
                    color: Theme.text;
                }

                if root.page == 0: HorizontalLayout {
                    spacing: 8px;

                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;

                        for choice in root.column-choices-left: CheckBox {
                            text: choice.title;
                            checked: choice.shown;
                            toggled => {
                                root.column-toggled(choice.index, self.checked);
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        alignment: start;

                        for choice in root.column-choices-right: CheckBox {
                            text: choice.title;
                            checked: choice.shown;
                            toggled => {
                                root.column-toggled(choice.index, self.checked);
                            }
                        }
                    }
                }

                if root.page == 0: Text {
                    text: "Highlighting";
                    font-weight: 600;
                    color: Theme.text;
                }

                if root.page == 0: GridLayout {
                    spacing-horizontal: 14px;
                    spacing-vertical: 4px;

                    Row {
                        LegendItem {
                            text: "Your processes";
                            swatch: Theme.own-process;
                        }

                        LegendItem {
                            text: "Elevated (yours)";
                            swatch: Theme.elevated-process;
                        }
                    }

                    Row {
                        LegendItem {
                            text: "Hosts services";
                            swatch: Theme.service-process;
                        }

                        LegendItem {
                            text: "System accounts";
                            swatch: Theme.system-process;
                        }
                    }

                    Row {
                        LegendItem {
                            text: "Just started";
                            swatch: Theme.new-process;
                        }

                        LegendItem {
                            text: "Just exited";
                            swatch: Theme.exited-process;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 6px;

                    Button {
                        text: "Ping…";
                        clicked => {
                            view-menu.close();
                            root.show-page(6);
                        }
                    }

                    Button {
                        text: "Run…";
                        clicked => {
                            view-menu.close();
                            root.run-open = true;
                        }
                    }

                    Button {
                        text: "Find…";
                        clicked => {
                            view-menu.close();
                            root.show-page(5);
                        }
                    }

                    Button {
                        text: "About";
                        clicked => {
                            view-menu.close();
                            about.show();
                        }
                    }
                }
            }
        }
    }

    about := PopupWindow {
        x: (root.width - 380px) / 2;
        y: 80px;
        width: 380px;
        height: 330px;

        Rectangle {
            border-radius: 8px;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 18px;
                spacing: 8px;

                Text {
                    text: "Ferrotop " + root.version;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "A memory-safe process explorer for Windows, written in Rust. Its process provider, CPU accounting and NT structure layouts are ported from System Informer (MIT, Winsider Seminars & Solutions).";
                    wrap: word-wrap;
                    color: Theme.text;
                }

                AboutSlint {
                    vertical-stretch: 1;
                }
            }
        }
    }
}
